# =========================================================================
# .apk
*.aab
*.dex
captures/
.externalNativeBuild/
.cxx/
output-metadata.json

# Local SDK and environment properties (contains machine-specific paths)
local.properties

# Secrets and Signing files (NEVER commit these)
*.jks
*.keystore
signing/
secrets.properties

